# VRCX Cloud Server Configuration

# Server
PORT=3000
HOST=0.0.0.0

# API Key for desktop client authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=68162ad9ac560dfdda61282d24ef9df2726882f21fa8c09f757bc6cb0b0072f3

# Encryption key for stored VRChat cookies (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=cd8083b26ed9dc1abe809a8a01f5ff86f46ca89aed3aeae1340fd18e6c893e2b

# Database path (default: ./data/vrcx-cloud.db)
DATABASE_PATH=./data/vrcx-cloud.db

# VRChat API
VRCHAT_API_BASE=https://api.vrchat.cloud/api/1
VRCHAT_USER_AGENT=VRCX-Cloud/0.1.0

# Polling intervals (in milliseconds)
POLL_FRIENDS_INTERVAL=120000
POLL_NOTIFICATIONS_INTERVAL=30000
POLL_WORLDS_INTERVAL=600000
POLL_AVATARS_INTERVAL=600000

# Log level: debug | info | warn | error
LOG_LEVEL=info
